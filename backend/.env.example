# Server Port
PORT=5000

# AI Provider API Keys
# Lấy API Key tại: https://pollinations.ai (đăng nhập để lấy secret key định dạng sk_...)
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Lấy Token tại: https://huggingface.co/settings/tokens (quyền Read)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Cloudinary Storage Configuration (Tùy chọn - Dùng cho Gallery lưu ảnh CDN)
# Lấy thông số tại: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Render URL khi deploy (Tùy chọn)
RENDER_EXTERNAL_URL=
